        [
          "I",
          "I'm",
          "I'm not"
        ],
        [
          "you",
          "you're",
          "you aren't"
        ],
        [
          "he / she / it",
          "he's / she's / it's",
          "he isn't / she isn't / it isn't"
        ],
        [
          "we",
          "we're",
          "we aren't"
        ],
        [
          "they",
          "they're",
          "they aren't"
        ]
      ]
    },
    "exemplos": [
      {
        "en": "We aren't late. We're early!",
        "pt": "Não estamos atrasados. Estamos adiantados!"
