          "my",
          "my mother"
        ],
        [
          "meus / minhas",
          "my",
          "my parents"
        ],
        [
          "seu / sua (de você)",
          "your",
          "your sister"
        ],
        [
          "seus / suas (de você)",
          "your",
          "your children"
        ]
      ]
    },
