          "He works in a hospital."
        ],
        [
          "she",
          "lives",
          "She lives in Rio."
        ],
        [
          "it",
          "starts",
          "The movie starts at nine."
        ],
        [
          "my boss / Ana",
          "drives",
          "My boss drives a red car."
        ]
      ]
    },
