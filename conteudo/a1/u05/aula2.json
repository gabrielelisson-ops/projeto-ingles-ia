  "gramatica": {
    "titulo": "Regras do -s",
    "explicacao_pt": "Na maioria dos verbos, só acrescente -s: work → works, play → plays. Verbos terminados em -ch, -sh, -ss, -x, -o ganham -ES: watch → watches, wash → washes, fix → fixes, go → goes, do → does. Consoante + y vira -IES: study → studies, try → tries (mas vogal + y fica -s: play → plays). Irregular: have → HAS. Pronúncia: -es em watches/fixes soa como 'iz' (uót-chiz).",
    "tabela": {
      "colunas": [
        "Terminação",
        "Regra",
        "Exemplos"
      ],
      "linhas": [
        [
          "maioria",
          "+ s",
          "works, plays, drives"
        ],
        [
          "-ch, -sh, -ss, -x, -o",
          "+ es",
          "watches, washes, fixes, goes, does"
        ],
        [
          "consoante + y",
          "y → ies",
          "studies, tries, carries"
        ],
        [
          "have",
          "irregular",
          "has"
        ]
      ]
    },
