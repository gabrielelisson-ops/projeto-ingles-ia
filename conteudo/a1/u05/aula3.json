  "gramatica": {
    "titulo": "Does e doesn't",
    "explicacao_pt": "Com he, she e it, usamos DOES para perguntar e DOESN'T para negar. Muito importante: quando aparece does/doesn't, o -s SAI do verbo principal (porque já está no does): She works → Does she work? → She doesn't work. Respostas curtas: Yes, she does. / No, he doesn't. Com palavras de pergunta: Where does he live? What time does it close?",
    "tabela": {
      "colunas": [
        "Tipo",
        "Estrutura",
        "Exemplo"
      ],
      "linhas": [
        [
          "Afirmativa",
          "he/she + verbo-s",
          "She drives."
        ],
        [
          "Negativa",
          "he/she + doesn't + verbo",
          "She doesn't drive."
        ],
        [
          "Pergunta",
          "Does + he/she + verbo?",
          "Does she drive?"
        ],
        [
          "Resposta",
          "Yes, she does. / No, she doesn't.",
          "No, she doesn't."
        ],
        [
          "Com palavra",
          "Where/What/When + does…?",
          "Where does she work?"
        ]
      ]
    },
    "exemplos": [
      {
        "en": "Does your wife speak English? — A little.",
        "pt": "Sua esposa fala inglês? — Um pouco."
      },
      {
        "en": "My boss doesn't like long meetings.",
        "pt": "Meu chefe não gosta de reuniões longas."
      },
      {
        "en": "What time does the store open?",
        "pt": "A que horas a loja abre?"
      },
      {
        "en": "The machine doesn't need oil today.",
        "pt": "A máquina não precisa de óleo hoje."
      }
    ]
  },
