      "colunas": [
        "Número",
        "Perto",
        "Longe"
      ],
      "linhas": [
        [
          "Singular",
          "this shirt (esta camisa)",
          "that shirt (aquela camisa)"
        ],
        [
          "Plural",
          "these shoes (estes sapatos)",
          "those shoes (aqueles sapatos)"
        ],
        [
          "Com verbo",
          "This is / These are",
          "That is / Those are"
        ]
      ]
    },
