  "gramatica": {
    "titulo": "There is / There are",
    "explicacao_pt": "Para dizer que algo EXISTE num lugar (o nosso 'tem' ou 'há'), use THERE IS para uma coisa e THERE ARE para várias: There is a sofa in the living room. There are two bedrooms. Atenção: brasileiros costumam dizer 'In my house have…' — está errado! Diga: There is / There are. Forma curta: there's. Negativa: there isn't / there aren't.",
    "tabela": {
      "colunas": [
        "Quantidade",
        "Afirmativa",
        "Negativa"
      ],
      "linhas": [
        [
          "uma coisa",
          "There is a TV.",
          "There isn't a TV."
        ],
        [
          "várias coisas",
          "There are two beds.",
          "There aren't any beds."
        ],
        [
          "forma curta",
          "There's a fridge.",
          "—"
        ]
      ]
    },
    "exemplos": [
      {
        "en": "There's a small kitchen and a big living room.",
        "pt": "Há uma cozinha pequena e uma sala grande."
      },
      {
        "en": "There are three bedrooms in my house.",
        "pt": "Há três quartos na minha casa."
      },
      {
        "en": "There isn't a garage.",
        "pt": "Não há garagem."
      },
      {
        "en": "There aren't any windows in the bathroom.",
        "pt": "Não há janelas no banheiro."
      }
    ]
  },
