  "gramatica": {
    "titulo": "Do e don't no presente simples",
    "explicacao_pt": "Para perguntar no presente simples (com I, you, we, they), coloque DO no começo: Do you work on Saturdays? Resposta curta: Yes, I do. / No, I don't. Para negar, coloque DON'T (do not) antes do verbo: I don't drink coffee. Com palavras de pergunta: What time DO you start? Where DO they live? Atenção: não use to be junto com outro verbo — diga 'I work', não 'I am work'.",
    "tabela": {
      "colunas": [
        "Tipo",
        "Estrutura",
        "Exemplo"
      ],
      "linhas": [
        [
          "Pergunta",
          "Do + pessoa + verbo?",
          "Do you work on Saturdays?"
        ],
        [
          "Resposta",
          "Yes, I do. / No, I don't.",
          "No, I don't."
        ],
        [
          "Negativa",
          "pessoa + don't + verbo",
          "We don't work on Sundays."
        ],
        [
          "Com palavra",
          "What/Where/When + do…?",
          "What time do you start?"
        ]
      ]
    },
    "exemplos": [
      {
        "en": "Do they live near here? — Yes, they do.",
        "pt": "Eles moram perto daqui? — Sim."
      },
      {
        "en": "I don't drive. I take the bus.",
        "pt": "Não dirijo. Pego ônibus."
      },
      {
        "en": "What time do you finish work?",
        "pt": "A que horas você termina o trabalho?"
      },
      {
        "en": "Where do you have lunch? — In the cafeteria.",
        "pt": "Onde você almoça? — No refeitório."
      }
    ]
  },
