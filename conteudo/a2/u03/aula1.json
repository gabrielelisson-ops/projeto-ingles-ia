  "gramatica": {
    "titulo": "Present continuous: am / is / are + -ing",
    "explicacao_pt": "Para o que está acontecendo AGORA, use o verbo to be + verbo com -ing: I am working (estou trabalhando), she is cooking, they are waiting. Regras: verbo com -e perde o e (make → making); consoante-vogal-consoante dobra (run → running, stop → stopping). Negativa: I'm not working, he isn't sleeping. Pergunta: Are you working? What are you doing? Não esqueça o 'am/is/are' — 'I working' está errado!",
    "tabela": {
      "colunas": [
        "Pessoa",
        "Afirmativa",
        "Pergunta"
      ],
      "linhas": [
        [
          "I",
          "I'm working.",
          "Am I…?"
        ],
        [
          "you / we / they",
          "They're waiting.",
          "Are they waiting?"
        ],
        [
          "he / she / it",
          "It's raining.",
          "Is it raining?"
        ],
        [
          "negativa",
          "She isn't sleeping.",
          "—"
        ]
      ]
    },
    "exemplos": [
      {
        "en": "What are you doing? — I'm cooking dinner.",
        "pt": "O que você está fazendo? — Estou fazendo o jantar."
      },
      {
        "en": "The kids are playing in the garden.",
        "pt": "As crianças estão brincando no jardim."
      },
      {
        "en": "It isn't raining now. Let's go!",
        "pt": "Não está chovendo agora. Vamos!"
      },
      {
        "en": "Is the machine running? — Yes, it is.",
        "pt": "A máquina está funcionando? — Sim."
      }
    ]
  },
