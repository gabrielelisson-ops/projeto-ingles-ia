  "gramatica": {
    "titulo": "Did e didn't no passado",
    "explicacao_pt": "Para perguntar no passado: DID + pessoa + verbo na forma básica: Did you work? (nunca 'Did you worked?'). Negativa: DIDN'T + verbo básico: I didn't work. Ou seja, o passado fica no 'did' e o verbo volta ao normal. Respostas curtas: Yes, I did. / No, she didn't. Com palavras de pergunta: What did you do? Where did they go? What time did it start?",
    "tabela": {
      "colunas": [
        "Tipo",
        "Estrutura",
        "Exemplo"
      ],
      "linhas": [
        [
          "Afirmativa",
          "verbo + ed",
          "She called."
        ],
        [
          "Negativa",
          "didn't + verbo",
          "She didn't call."
        ],
        [
          "Pergunta",
          "Did + pessoa + verbo?",
          "Did she call?"
        ],
        [
          "Resposta",
          "Yes, she did. / No, she didn't.",
          "No, she didn't."
        ],
        [
          "Com palavra",
          "What/When… + did…?",
          "When did she call?"
        ]
      ]
    },
    "exemplos": [
      {
        "en": "Did you finish the report? — Not yet. I didn't have time.",
        "pt": "Você terminou o relatório? — Ainda não. Não tive tempo."
      },
